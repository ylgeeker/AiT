#!/bin/sh
# Cursor may use `git commit --trailer`, which appends AFTER the commit-msg hook.
# Rewrite HEAD in place when a Cursor attribution trailer is still present.

if [ -n "$CURSOR_TRAILER_REWRITE" ]; then
	exit 0
fi

. "$(dirname "$0")/strip-cursor-trailers-lib.sh"

msg=$(git log -1 --format=%B)
if ! message_has_cursor_trailer "$msg"; then
	exit 0
fi

cleaned=$(echo "$msg" | strip_cursor_trailer_lines | trim_trailing_blank_lines)
tree=$(git rev-parse 'HEAD^{tree}')
parent=$(git rev-parse 'HEAD^' 2>/dev/null) || parent=""

export GIT_AUTHOR_NAME="$(git log -1 --format=%an)"
export GIT_AUTHOR_EMAIL="$(git log -1 --format=%ae)"
export GIT_AUTHOR_DATE="$(git log -1 --format=%aI)"
export GIT_COMMITTER_NAME="$(git log -1 --format=%cn)"
export GIT_COMMITTER_EMAIL="$(git log -1 --format=%ce)"
export GIT_COMMITTER_DATE="$(git log -1 --format=%cI)"

export CURSOR_TRAILER_REWRITE=1
if [ -n "$parent" ]; then
	new=$(printf '%s\n' "$cleaned" | git commit-tree "$tree" -p "$parent") || exit 0
else
	new=$(printf '%s\n' "$cleaned" | git commit-tree "$tree") || exit 0
fi

branch=$(git symbolic-ref -q HEAD)
if [ -n "$branch" ]; then
	git update-ref "$branch" "$new" HEAD
else
	git update-ref HEAD "$new" HEAD
fi

exit 0
