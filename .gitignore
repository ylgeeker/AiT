# Go — https://github.com/github/gitignore/blob/main/Go.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build output (make build / make build-cross)
/bin/
/dist/

# Accidental root-level builds (use bin/ait per CONTRIBUTING)
/ait
/ait.exe

# Local Go tool caches (when GOMODCACHE/GOCACHE/TMPDIR point at repo)
.gocache/
.test-fresh-gomodcache/
.tmp/

# Python bytecode, caches, and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
ENV/
env/

# Python E2E tests (local secrets and temp)
tests/config.local.yaml
tests/.env
tests/.tmp/
tests/.venv/

# Secrets and local runtime (dev with AIT_HOME in repo)
.env
/config.yaml
/*.log
ait.db
*.db-journal
repl_history
keyring/

# Editor / IDE ( .cursor/rules/ is tracked intentionally )
.vscode/
.idea/
.codebuddy

# OS junk
.DS_Store
Thumbs.db
