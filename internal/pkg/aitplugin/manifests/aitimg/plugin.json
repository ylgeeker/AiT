{
  "apiVersion": 1,
  "name": "img",
  "binary": "aitimg",
  "short": "Extract image metadata (EXIF, GPS, device)",
  "order": 30,
  "usage": "img [flags] <image-path>",
  "flags": [
    {
      "name": "json",
      "type": "bool",
      "help": "JSON output"
    },
    {
      "name": "geocode",
      "type": "bool",
      "help": "reverse-geocode GPS coordinates"
    },
    {
      "name": "help",
      "short": "h",
      "type": "bool",
      "help": "help for img"
    }
  ],
  "examples": [
    "img photo.jpg",
    "img --json photo.jpg",
    "img --geocode photo.jpg"
  ]
}
